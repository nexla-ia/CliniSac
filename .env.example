# CliniSac — variáveis de ambiente
# Copie este arquivo para ".env" (local) e configure também nas
# Environment Variables da Vercel. NUNCA comite o .env (já está no .gitignore).

# Projeto Supabase NOVO do CliniSac (crie um projeto próprio no supabase.com):
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI

# URL pública do site, sem barra no fim. Entra nas tags Open Graph (preview
# ao compartilhar o link no WhatsApp). Configure também na Vercel.
VITE_SITE_URL=https://clinisac.com.br
